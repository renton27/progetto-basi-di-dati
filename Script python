atto_Dati), parametri)\n","        con.execute(text(QuerySuContratto_Fonia), parametri)\n","        con.commit()\n","\n","    except Exception as e:\n","        print(f\"Errore durante l'esecuzione della query: {e}\")\n","        return None\n","\n","\n"],"metadata":{"id":"FCgif5vfFBAI","executionInfo":{"status":"ok","timestamp":1738000314349,"user_tz":-60,"elapsed":230,"user":{"displayName":"Edoardo Abballe","userId":"15014463527680642270"}}},"execution_count":28,"outputs":[]},{"cell_type":"code","source":["\n","PianiF = widgets.Dropdown(\n","  options = [\n","'Piano Smart',\n","'Piano Ultra',\n","'Piano Family',\n","'Piano Young Plus',\n","'Piano Business',\n","'Piano Silver',\n","'Piano Complete',\n","'Piano Home Pro',\n","'Piano Student',\n","'Piano Executive Plus'\n","],\n","  value='Piano Smart',\n","  description='Piano Fonia:',\n","  disabled=False,\n",")\n","\n","\n","PianiD = widgets.Dropdown(\n","  options = ['DATAMAX',\n","'TURBONET',\n","'SMARTCONNECT',\n","'ULTRASPEED',\n","'INFINITY',\n","'FLEX',\n","'STREAM MASTER',\n","'DATAWAVE',\n","'ECODATA',\n","'MEGABOOST'],\n","  value='DATAMAX',\n","  description='Piano Dati:',\n","  disabled=False,\n",")\n","\n","Nome = widgets.Text(\n","  value='',\n","  placeholder='Type something',\n","  description='Nome:',\n","  disabled=False,\n","\n",")\n","Cognome = widgets.Text(\n","  value='',\n","  placeholder='Type something',\n","  description='Cognome:',\n","  disabled=False,\n","\n",")\n","Indirizzo = widgets.Text(\n","  value='',\n","  placeholder='Type something',\n","  description='Indirizzo:',\n","  disabled=False,\n","\n",")\n","Numero = widgets.Text(\n","  value='',\n","  placeholder='Type something',\n","  description='Numero:',\n","  disabled=False,\n","\n",")\n","Tipologia = widgets.Dropdown(\n","  options = ['1 - Small',\n","'2 - Mid',\n","'3 - Top ',\n","],\n","  value='1 - Small',\n","  description='Tipologia cliente:',\n","  disabled=False,\n","  style = {'description_width': 'initial'},\n","  lay